{
  "benchmark_version": "step29-v1",
  "dataset_version": "synthetic-v2",
  "seed": 20261025,
  "model": {"provider": "deterministic-rules", "model_version": "rules-v1", "prompt_versions": {"triage": "triage-v1", "scheduling": "scheduling-v1", "safety": "safety-v1", "rag": "retrieval-v1"}},
  "parameters": {"rag_top_k": 5, "triage_confidence_threshold": 0.75, "rag_chunk_target_tokens": 800, "rag_chunk_overlap_tokens": 120},
  "datasets": [
    {"name": "triage", "path": "datasets/triage_gold.jsonl", "task": "triage", "minimum_count": 6, "metrics": ["category_accuracy", "priority_accuracy"]},
    {"name": "facility_matching", "path": "datasets/facility_matching_gold.jsonl", "task": "facility_matching", "minimum_count": 5, "metrics": ["category_accuracy", "facility_id_accuracy", "confirmation_accuracy"]},
    {"name": "sla_scheduling", "path": "datasets/scheduling_gold.jsonl", "task": "sla_scheduling", "minimum_count": 3, "metrics": ["priority_accuracy", "sla_minutes_accuracy"]},
    {"name": "state_transition", "path": "datasets/state_transition_gold.jsonl", "task": "state_transition", "minimum_count": 10, "metrics": ["transition_accuracy"]},
    {"name": "rag_retrieval", "path": "datasets/rag_retrieval_gold.jsonl", "task": "rag_retrieval", "minimum_count": 5, "metrics": ["hit_rate_at_5", "mrr"]},
    {"name": "high_risk", "path": "datasets/high_risk_gold.jsonl", "task": "high_risk", "minimum_count": 5, "metrics": ["risk_accuracy", "confirmation_accuracy"]},
    {"name": "safety_acceptance", "path": "datasets/safety_acceptance_gold.jsonl", "task": "high_risk", "minimum_count": 3, "metrics": ["risk_accuracy", "confirmation_accuracy"]}
  ],
  "thresholds": {"category_accuracy": 0.9, "priority_accuracy": 0.9, "facility_id_accuracy": 0.8, "confirmation_accuracy": 0.95, "sla_minutes_accuracy": 0.9, "transition_accuracy": 1.0, "hit_rate_at_5": 0.8, "mrr": 0.7, "risk_accuracy": 0.95}
}
