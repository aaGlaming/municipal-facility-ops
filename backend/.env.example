APP_ENV=development
MYSQL_URL=mysql+pymysql://municipal:municipal_dev@127.0.0.1:3306/municipal_ops
CHROMA_PERSIST_DIRECTORY=.chroma
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_me
# 独立 Embedding 服务；留空时回退到 LLM_BASE_URL/LLM_API_KEY
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# OpenAI-compatible Rerank 服务的完整 HTTP 地址，例如服务提供商的 /rerank 接口
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=30
RERANK_MAX_RETRIES=2
# 公开 Open311/NYC Open Data 数据源基础地址，仅供公开数据下载脚本使用
OPEN311_BASE_URL=https://data.cityofnewyork.us
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
CORS_ORIGINS=http://localhost:5173
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
AUTH_SECRET=replace_with_a_32_character_secret
AUTH_TOKEN_TTL_SECONDS=900
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_ROLES=admin
AUTH_BOOTSTRAP_PERMISSIONS=*
RAG_STORAGE_DIRECTORY=uploads/documents
RAG_MAX_UPLOAD_BYTES=10485760
RAG_CHUNK_TARGET_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=120
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RATE_LIMIT_PER_MINUTE=60
EMBEDDING_CACHE_DIRECTORY=.cache/embeddings
CHROMA_COLLECTION_NAME=municipal_facility_ops
